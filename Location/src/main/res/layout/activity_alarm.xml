<?xml version="1.0" encoding="utf-8"?>

<!--
  The STOP button intentionally fills most of the screen: the user may be
  reaching for it in the dark, in a pocket, or in a hurry. An incoming-SMS
  heads-up notification occupies the top of the screen, so the button is kept
  well below it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".activity.AlarmActivity">

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:gravity="center"
        android:text="@string/alarm_notification_title"
        android:textColor="@color/alarm_foreground"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/alarm_notification_text"
        android:textColor="@color/alarm_foreground"
        android:textSize="16sp" />

    <Button
        android:id="@+id/stop_alarm_button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="48dp"
        android:backgroundTint="@color/alarm_foreground"
        android:text="@string/stop_alarm_button"
        android:textColor="@color/alarm_background"
        android:textSize="48sp"
        android:textStyle="bold" />

</LinearLayout>
